# TrackFlow API — copia este archivo a services/.env y pon valores reales. .env nunca se versiona.
# Valores de ejemplo ficticios.

ENVIRONMENT=local

# JWT: clave de firma de al menos 32 caracteres. Genera una con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# TinyDB (usuarios y perfiles). Por defecto: services/.data/users.json (ignorado por git).
# TINYDB_PATH=

# Orígenes de los frontends separados por comas. En Codespaces se añaden solos los del codespace.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Solo para seed_admin.py (crear el primer admin)
ADMIN_EMAIL=admin@trackflow.example
ADMIN_PASSWORD=
