# TrackFlow API — plantilla de variables de entorno (propuesta de arquitectura, §6).
# Aquí solo van los NOMBRES, vacíos o con valores ficticios. Nunca pongas valores reales en este archivo.
# Copia la plantilla a services/.env (ignorado por git) y rellena allí los valores reales,
# o defínelos como Codespaces secrets (Settings → Codespaces → Secrets).

ENVIRONMENT=local

# TinyDB (usuarios y perfiles). Si no se define: services/.data/users.json (ignorado por git).
# TINYDB_PATH=

# Orígenes de los frontends, separados por comas. En Codespaces se añaden solos los del codespace.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT: clave de firma de al menos 32 caracteres. Se genera y se pone solo en services/.env.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
